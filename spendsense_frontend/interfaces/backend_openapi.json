{
  "openapi": "3.0.0",
  "info": {
    "title": "My Express API",
    "version": "1.0.0",
    "description": "A simple Express API documented with Swagger"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Health endpoint",
        "responses": {
          "200": {
            "description": "Service health check passed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "message": {
                      "type": "string",
                      "example": "Service is healthy"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "environment": {
                      "type": "string",
                      "example": "development"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}
