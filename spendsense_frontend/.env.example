# SpendSense Frontend (.env.example)
# Copy to .env (or configure via your deployment environment) and fill in values.
# IMPORTANT: Create React App only exposes environment variables prefixed with REACT_APP_.

# -----------------------------------------------------------------------------
# Supabase (required if using Supabase auth/data)
# -----------------------------------------------------------------------------
# Your Supabase project URL, e.g. https://xxxx.supabase.co
REACT_APP_SUPABASE_URL=

# Your Supabase anon/public key (safe to use in frontend; do NOT use service role key here)
REACT_APP_SUPABASE_KEY=

# -----------------------------------------------------------------------------
# Backend / API configuration (optional; used by src/config/api.js)
# -----------------------------------------------------------------------------
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=

# -----------------------------------------------------------------------------
# Optional app URLs
# -----------------------------------------------------------------------------
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# -----------------------------------------------------------------------------
# Misc / flags
# -----------------------------------------------------------------------------
REACT_APP_NODE_ENV=
REACT_APP_LOG_LEVEL=
REACT_APP_HEALTHCHECK_PATH=
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
REACT_APP_ENABLE_SOURCE_MAPS=
REACT_APP_NEXT_TELEMETRY_DISABLED=
REACT_APP_PORT=
REACT_APP_TRUST_PROXY=
